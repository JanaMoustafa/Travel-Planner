# Primary LLM — Groq (recommended; free tier)
GROQ_API_KEY=
GROQ_MODEL=llama3-8b-8192

# Optional fallback: OpenAI-compatible API
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# Web search — Tavily (AI-powered, recommended for LLM agents)
TAVILY_API_KEY=

# Hugging Face (dataset / model download)
HF_TOKEN=

# Paths
CHROMA_PERSIST_DIR=./chroma_db
SOLVER_LORA_PATH=./artifacts/solver-lora

# Inference
MAX_AUDIT_ITERATIONS=3
